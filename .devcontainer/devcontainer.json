{
  "name": "Entorno Airflow y Kafka",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    }
  },
  "remoteEnv": {
    "AIRFLOW_HOME": "${containerWorkspaceFolder}",
    "AIRFLOW__CORE__LOAD_EXAMPLES": "False"
  },
  "forwardPorts": [8080, 8501, 9092, 5432],
  "portsAttributes": {
    "8080": {
      "label": "Airflow UI",
      "onAutoForward": "notify"
    },
    "8501": {
      "label": "Streamlit Dashboard",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y postgresql && pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "settings": {
        "python.terminal.useEnvFile": true
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
